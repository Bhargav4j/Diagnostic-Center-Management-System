@page "{id:int}"
@model DiagnosticCenter.Web.Pages.Payment.DeleteModel
@{
    ViewData["Title"] = "Delete Payment";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h2 class="card-title mb-0">Confirm Deletion</h2>
                </div>
                <div class="card-body">
                    <div class="alert alert-danger" role="alert">
                        <strong>Warning:</strong> You are about to delete the following payment record. This action cannot be undone.
                    </div>

                    <form method="post">
                        <input type="hidden" asp-for="Payment.Id" />

                        <div class="row">
                            <div class="col-md-6">
                                <div class="row mb-3">
                                    <label class="col-sm-5 col-form-label fw-bold">Bill Number:</label>
                                    <div class="col-sm-7">
                                        <p class="form-control-plaintext">@Model.Payment.BillNo</p>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <label class="col-sm-5 col-form-label fw-bold">Mobile Number:</label>
                                    <div class="col-sm-7">
                                        <p class="form-control-plaintext">@Model.Payment.MobileNo</p>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <label class="col-sm-5 col-form-label fw-bold">Payment Date:</label>
                                    <div class="col-sm-7">
                                        <p class="form-control-plaintext">@Model.Payment.PaymentDate.ToString("MM/dd/yyyy")</p>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="row mb-3">
                                    <label class="col-sm-5 col-form-label fw-bold">Total Amount:</label>
                                    <div class="col-sm-7">
                                        <p class="form-control-plaintext">@Model.Payment.TotalAmount.ToString("C")</p>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <label class="col-sm-5 col-form-label fw-bold">Paid Amount:</label>
                                    <div class="col-sm-7">
                                        <p class="form-control-plaintext">@Model.Payment.PaidAmount.ToString("C")</p>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <label class="col-sm-5 col-form-label fw-bold">Due Amount:</label>
                                    <div class="col-sm-7">
                                        <span class="badge @(Model.Payment.DueAmount > 0 ? "bg-warning text-dark" : "bg-success") fs-6">
                                            @Model.Payment.DueAmount.ToString("C")
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="row mb-3">
                                    <label class="col-sm-5 col-form-label fw-bold">Status:</label>
                                    <div class="col-sm-7">
                                        <span class="badge @(Model.Payment.IsActive ? "bg-success" : "bg-danger")">
                                            @(Model.Payment.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-page="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-trash me-1"></i>Confirm Delete
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
