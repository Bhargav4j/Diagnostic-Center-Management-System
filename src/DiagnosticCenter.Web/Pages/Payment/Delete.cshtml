@page "{id:int}"
@model DiagnosticCenter.Web.Pages.Payment.DeleteModel
@{
    ViewData["Title"] = "Delete Payment";
}

<div class="container mt-4">
    <h2>Delete Payment</h2>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    @if (Model.Payment != null)
    {
        <div class="alert alert-warning">
            <h4>Are you sure you want to delete this payment?</h4>
            <p>This action cannot be undone.</p>
        </div>

        <div class="card">
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">ID</dt>
                    <dd class="col-sm-9">@Model.Payment.Id</dd>

                    <dt class="col-sm-3">Test Entry (Bill No)</dt>
                    <dd class="col-sm-9">@Model.Payment.TestEntryBillNo</dd>

                    <dt class="col-sm-3">Amount</dt>
                    <dd class="col-sm-9">@Model.Payment.Amount.ToString("C")</dd>

                    <dt class="col-sm-3">Payment Date</dt>
                    <dd class="col-sm-9">@Model.Payment.PaymentDate.ToString("d")</dd>

                    <dt class="col-sm-3">Payment Mode</dt>
                    <dd class="col-sm-9">@Model.Payment.PaymentMode</dd>

                    @if (!string.IsNullOrEmpty(Model.Payment.Notes))
                    {
                        <dt class="col-sm-3">Notes</dt>
                        <dd class="col-sm-9">@Model.Payment.Notes</dd>
                    }
                </dl>
            </div>
        </div>

        <form method="post" class="mt-3">
            <button type="submit" class="btn btn-danger">Confirm Delete</button>
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
        </form>
    }
</div>
