@page
@model DiagnosticCenter.Web.Pages.TestTypes.DeleteModel
@{
    ViewData["Title"] = "Delete Test Type";
}

<h2>Delete Test Type</h2>

<h3>Are you sure you want to delete this?</h3>
<hr />
@if (Model.TestType != null)
{
    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.TestType.Name</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Model.TestType.Description</dd>

        <dt class="col-sm-3">Created Date</dt>
        <dd class="col-sm-9">@Model.TestType.CreatedDate.ToString("yyyy-MM-dd")</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </form>
}
else
{
    <p>Test type not found.</p>
    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
}
