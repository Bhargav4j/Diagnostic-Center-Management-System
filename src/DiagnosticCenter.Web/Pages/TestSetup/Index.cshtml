@page
@model DiagnosticCenter.Web.Pages.TestSetup.IndexModel
@{
    ViewData["Title"] = "Test Setups";
}

<h2>Test Setups</h2>

<div class="mb-3">
    <a asp-page="Create" class="btn btn-primary">Create New Test Setup</a>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Fee</th>
                <th>Test Type</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.TestSetups)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Fee.ToString("C")</td>
                    <td>@item.TypeName</td>
                    <td>
                        <a asp-page="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                        <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-page="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
