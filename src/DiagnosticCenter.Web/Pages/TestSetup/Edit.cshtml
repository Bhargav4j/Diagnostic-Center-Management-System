@page "{id:int}"
@model DiagnosticCenter.Web.Pages.TestSetup.EditModel
@{
    ViewData["Title"] = "Edit Test Setup";
}

<div class="container mt-4">
    <h2>Edit Test Setup</h2>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }

    <form method="post">
        <div class="mb-3">
            <label asp-for="Name" class="form-label">Test Name</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Fee" class="form-label">Fee</label>
            <input asp-for="Fee" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="Fee" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="TypeId" class="form-label">Test Type</label>
            <select asp-for="TypeId" class="form-select" asp-items="Model.TestTypes">
                <option value="">-- Select Test Type --</option>
            </select>
            <span asp-validation-for="TypeId" class="text-danger"></span>
        </div>

        <div class="mb-3 form-check">
            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
            <label asp-for="IsActive" class="form-check-label">Active</label>
        </div>

        <div class="mb-3">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
