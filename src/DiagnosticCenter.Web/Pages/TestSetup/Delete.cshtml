@page
@model DiagnosticCenter.Web.Pages.TestSetup.DeleteModel
@{
    ViewData["Title"] = "Delete Test";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-trash"></i> Delete Test
                    </h4>
                </div>
                <div class="card-body">
                    @if (Model.TestSetup != null)
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle"></i>
                            <strong>Warning!</strong> Are you sure you want to delete this test? This action cannot be undone.
                        </div>

                        <dl class="row">
                            <dt class="col-sm-3">ID</dt>
                            <dd class="col-sm-9">@Model.TestSetup.Id</dd>

                            <dt class="col-sm-3">Test Name</dt>
                            <dd class="col-sm-9">@Model.TestSetup.Name</dd>

                            <dt class="col-sm-3">Test Type</dt>
                            <dd class="col-sm-9">@(Model.TestSetup.TypeName ?? "N/A")</dd>

                            <dt class="col-sm-3">Fee</dt>
                            <dd class="col-sm-9">@Model.TestSetup.Fee.ToString("C")</dd>

                            <dt class="col-sm-3">Status</dt>
                            <dd class="col-sm-9">
                                @if (Model.TestSetup.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </dd>

                            <dt class="col-sm-3">Created Date</dt>
                            <dd class="col-sm-9">@Model.TestSetup.CreatedDate.ToString("dd/MM/yyyy HH:mm")</dd>
                        </dl>

                        <form method="post">
                            <input type="hidden" asp-for="TestSetup!.Id" />
                            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                <a asp-page="Index" class="btn btn-secondary">
                                    <i class="bi bi-x-circle"></i> Cancel
                                </a>
                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-trash"></i> Delete Test
                                </button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle"></i> Test not found.
                        </div>
                        <a asp-page="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
