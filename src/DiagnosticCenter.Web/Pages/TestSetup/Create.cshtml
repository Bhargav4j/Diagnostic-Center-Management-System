@page
@model DiagnosticCenter.Web.Pages.TestSetup.CreateModel
@{
    ViewData["Title"] = "Create Test Setup";
}

<div class="container">
    <h1 class="mb-4">Create New Test</h1>

    <form method="post">
        <div class="mb-3">
            <label asp-for="TestSetup.Name" class="form-label">Test Name</label>
            <input asp-for="TestSetup.Name" class="form-control" />
            <span asp-validation-for="TestSetup.Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="TestSetup.Fee" class="form-label">Fee</label>
            <input asp-for="TestSetup.Fee" type="number" step="0.01" class="form-control" />
            <span asp-validation-for="TestSetup.Fee" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="TestSetup.TypeId" class="form-label">Test Type</label>
            <select asp-for="TestSetup.TypeId" class="form-control" asp-items="Model.TestTypes">
                <option value="">-- Select Test Type --</option>
            </select>
            <span asp-validation-for="TestSetup.TypeId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <button type="submit" class="btn btn-primary">Create</button>
            <a asp-page="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
