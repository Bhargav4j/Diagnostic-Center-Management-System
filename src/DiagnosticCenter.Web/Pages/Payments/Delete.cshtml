@page
@model DiagnosticCenter.Web.Pages.Payments.DeleteModel
@{
    ViewData["Title"] = "Delete Payment";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0"><i class="bi bi-trash"></i> Delete Payment</h4>
                </div>
                <div class="card-body">
                    @if (Model.Payment != null)
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle"></i>
                            <strong>Warning!</strong> Are you sure you want to delete this payment? This action cannot be undone.
                        </div>

                        <dl class="row">
                            <dt class="col-sm-3">Payment ID</dt>
                            <dd class="col-sm-9">@Model.Payment.Id</dd>

                            <dt class="col-sm-3">Bill Number</dt>
                            <dd class="col-sm-9">
                                <span class="badge bg-primary">@Model.Payment.BillNo</span>
                            </dd>

                            <dt class="col-sm-3">Payment Amount</dt>
                            <dd class="col-sm-9">
                                <strong class="text-success">@Model.Payment.Amount.ToString("C")</strong>
                            </dd>

                            <dt class="col-sm-3">Payment Date</dt>
                            <dd class="col-sm-9">@Model.Payment.PaymentDate.ToString("dd/MM/yyyy")</dd>

                            <dt class="col-sm-3">Patient Name</dt>
                            <dd class="col-sm-9">@(Model.Payment.PatientName ?? "N/A")</dd>

                            <dt class="col-sm-3">Test</dt>
                            <dd class="col-sm-9">@(Model.Payment.TestName ?? "N/A")</dd>

                            <dt class="col-sm-3">Status</dt>
                            <dd class="col-sm-9">
                                @if (Model.Payment.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </dd>

                            <dt class="col-sm-3">Created Date</dt>
                            <dd class="col-sm-9">@Model.Payment.CreatedDate.ToString("dd/MM/yyyy HH:mm")</dd>
                        </dl>

                        <form method="post">
                            <input type="hidden" asp-for="Payment!.Id" />
                            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                <a asp-page="Index" class="btn btn-secondary">
                                    <i class="bi bi-x-circle"></i> Cancel
                                </a>
                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-trash"></i> Delete Payment
                                </button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle"></i> Payment not found.
                        </div>
                        <a asp-page="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
