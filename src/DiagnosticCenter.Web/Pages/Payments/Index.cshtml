@page
@model DiagnosticCenter.Web.Pages.Payments.IndexModel
@{
    ViewData["Title"] = "Payments";
}

<div class="container-fluid mt-4">
    <div class="row mb-3">
        <div class="col">
            <h2><i class="bi bi-cash-coin"></i> Payments</h2>
        </div>
        <div class="col-auto">
            <a asp-page="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Add New Payment
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <form method="get" class="mb-3">
                <div class="input-group">
                    <input type="text" name="searchTerm" value="@Model.SearchTerm"
                           class="form-control" placeholder="Search by bill number or patient name...">
                    <button type="submit" class="btn btn-outline-secondary">
                        <i class="bi bi-search"></i> Search
                    </button>
                    @if (!string.IsNullOrEmpty(Model.SearchTerm))
                    {
                        <a asp-page="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle"></i> Clear
                        </a>
                    }
                </div>
            </form>

            @if (Model.Payments.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Bill No</th>
                                <th>Payment Date</th>
                                <th>Amount</th>
                                <th>Patient Name</th>
                                <th>Test</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Payments)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td><span class="badge bg-primary">@item.BillNo</span></td>
                                    <td>@item.PaymentDate.ToString("dd/MM/yyyy")</td>
                                    <td><strong>@item.Amount.ToString("C")</strong></td>
                                    <td>@(item.PatientName ?? "N/A")</td>
                                    <td>@(item.TestName ?? "N/A")</td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-page="Details" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-info" title="Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-page="Edit" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-warning" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-page="Delete" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i>
                    @if (!string.IsNullOrEmpty(Model.SearchTerm))
                    {
                        <text>No payments found matching "@Model.SearchTerm".</text>
                    }
                    else
                    {
                        <text>No payments found. Click "Add New Payment" to create one.</text>
                    }
                </div>
            }
        </div>
    </div>
</div>
