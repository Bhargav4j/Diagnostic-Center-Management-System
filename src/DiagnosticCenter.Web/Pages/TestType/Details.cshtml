@page "{id:int}"
@model DiagnosticCenter.Web.Pages.TestType.DetailsModel
@{
    ViewData["Title"] = "Test Type Details";
}

<div class="container mt-4">
    <h2>Test Type Details</h2>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    @if (Model.TestType != null)
    {
        <div class="card">
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">ID</dt>
                    <dd class="col-sm-9">@Model.TestType.Id</dd>

                    <dt class="col-sm-3">Type Name</dt>
                    <dd class="col-sm-9">@Model.TestType.Name</dd>

                    <dt class="col-sm-3">Status</dt>
                    <dd class="col-sm-9">
                        @if (Model.TestType.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }
                    </dd>

                    <dt class="col-sm-3">Created</dt>
                    <dd class="col-sm-9">@Model.TestType.CreatedDate.ToString("g")</dd>

                    @if (Model.TestType.ModifiedDate.HasValue)
                    {
                        <dt class="col-sm-3">Modified</dt>
                        <dd class="col-sm-9">@Model.TestType.ModifiedDate.Value.ToString("g")</dd>
                    }
                </dl>
            </div>
            <div class="card-footer">
                <a asp-page="./Edit" asp-route-id="@Model.TestType.Id" class="btn btn-primary">Edit</a>
                <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    }
</div>
