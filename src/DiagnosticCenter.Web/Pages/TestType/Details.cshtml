@page "{id:int}"
@model DiagnosticCenter.Web.Pages.TestType.DetailsModel
@{
    ViewData["Title"] = "Test Type Details";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="card-title mb-0">Test Type Details</h2>
                    <a asp-page="Index" class="btn btn-secondary btn-sm">
                        <i class="fas fa-arrow-left me-1"></i>Back to List
                    </a>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <label class="col-sm-3 col-form-label fw-bold">Name:</label>
                        <div class="col-sm-9">
                            <p class="form-control-plaintext">@Model.TestType.Name</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-3 col-form-label fw-bold">Description:</label>
                        <div class="col-sm-9">
                            <p class="form-control-plaintext">@(Model.TestType.Description ?? "N/A")</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-3 col-form-label fw-bold">Status:</label>
                        <div class="col-sm-9">
                            <span class="badge @(Model.TestType.IsActive ? "bg-success" : "bg-danger")">
                                @(Model.TestType.IsActive ? "Active" : "Inactive")
                            </span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-3 col-form-label fw-bold">Created Date:</label>
                        <div class="col-sm-9">
                            <p class="form-control-plaintext">@Model.TestType.CreatedDate.ToString("g")</p>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-page="Edit" asp-route-id="@Model.TestType.Id" class="btn btn-warning">
                            <i class="fas fa-edit me-1"></i>Edit
                        </a>
                        <a asp-page="Delete" asp-route-id="@Model.TestType.Id" class="btn btn-danger">
                            <i class="fas fa-trash me-1"></i>Delete
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>