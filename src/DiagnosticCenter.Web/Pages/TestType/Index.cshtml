@page
@model DiagnosticCenter.Web.Pages.TestType.IndexModel
@{
    ViewData["Title"] = "Test Types";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1 class="mb-4">Test Types</h1>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Test Type List</h5>
                    <a asp-page="Create" class="btn btn-primary btn-sm">
                        <i class="fas fa-plus me-1"></i>Create New Test Type
                    </a>
                </div>
                <div class="card-body">
                    <form method="get" class="mb-3">
                        <div class="input-group">
                            <input type="text" asp-for="SearchTerm" class="form-control" placeholder="Search test types..." />
                            <button type="submit" class="btn btn-secondary">
                                <i class="fas fa-search me-1"></i>Search
                            </button>
                        </div>
                    </form>

                    @if (Model.TestTypes != null && Model.TestTypes.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Description</th>
                                        <th>Status</th>
                                        <th>Created Date</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var testType in Model.TestTypes)
                                    {
                                        <tr>
                                            <td>@testType.Name</td>
                                            <td>@(testType.Description ?? "N/A")</td>
                                            <td>
                                                @(testType.IsActive ?
                                                    "<span class='badge bg-success'>Active</span>" :
                                                    "<span class='badge bg-danger'>Inactive</span>")
                                            </td>
                                            <td>@testType.CreatedDate.ToString("g")</td>
                                            <td>
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <a asp-page="Details" asp-route-id="@testType.Id" class="btn btn-info">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a asp-page="Edit" asp-route-id="@testType.Id" class="btn btn-warning">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <a asp-page="Delete" asp-route-id="@testType.Id" class="btn btn-danger">
                                                        <i class="fas fa-trash"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            No test types found.
                            <a asp-page="Create" class="alert-link">Create a new test type</a>.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>