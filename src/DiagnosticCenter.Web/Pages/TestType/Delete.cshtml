@page "{id:int}"
@model DiagnosticCenter.Web.Pages.TestType.DeleteModel
@{
    ViewData["Title"] = "Delete Test Type";
}

<div class="container mt-4">
    <h2>Delete Test Type</h2>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    @if (Model.TestType != null)
    {
        <div class="alert alert-warning">
            <h4>Are you sure you want to delete this test type?</h4>
            <p>This action cannot be undone. Deleting this test type may affect associated test setups.</p>
        </div>

        <div class="card">
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">ID</dt>
                    <dd class="col-sm-9">@Model.TestType.Id</dd>

                    <dt class="col-sm-3">Type Name</dt>
                    <dd class="col-sm-9">@Model.TestType.Name</dd>

                    <dt class="col-sm-3">Status</dt>
                    <dd class="col-sm-9">
                        @if (Model.TestType.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        <form method="post" class="mt-3">
            <button type="submit" class="btn btn-danger">Confirm Delete</button>
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
        </form>
    }
</div>
