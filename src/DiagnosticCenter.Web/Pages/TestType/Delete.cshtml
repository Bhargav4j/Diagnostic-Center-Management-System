@page "{id:int}"
@model DiagnosticCenter.Web.Pages.TestType.DeleteModel
@{
    ViewData["Title"] = "Delete Test Type";
}

<h2>Delete Test Type</h2>

<h3>Are you sure you want to delete this?</h3>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.TestType?.Name</dd>

            <dt class="col-sm-3">Created Date</dt>
            <dd class="col-sm-9">@Model.TestType?.CreatedDate.ToString("yyyy-MM-dd")</dd>
        </dl>
    </div>
</div>

<form method="post" class="mt-3">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>
