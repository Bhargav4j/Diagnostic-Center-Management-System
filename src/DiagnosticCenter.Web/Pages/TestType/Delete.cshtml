@page "{id:int}"
@model DiagnosticCenter.Web.Pages.TestType.DeleteModel
@{
    ViewData["Title"] = "Delete Test Type";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h2 class="card-title mb-0">Confirm Deletion</h2>
                </div>
                <div class="card-body">
                    <div class="alert alert-danger" role="alert">
                        <strong>Warning:</strong> You are about to delete the following test type. This action cannot be undone.
                    </div>

                    <form method="post">
                        <input type="hidden" asp-for="TestType.Id" />

                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label fw-bold">Name:</label>
                            <div class="col-sm-9">
                                <p class="form-control-plaintext">@Model.TestType.Name</p>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label fw-bold">Description:</label>
                            <div class="col-sm-9">
                                <p class="form-control-plaintext">@(Model.TestType.Description ?? "N/A")</p>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label fw-bold">Status:</label>
                            <div class="col-sm-9">
                                <span class="badge @(Model.TestType.IsActive ? "bg-success" : "bg-danger")">
                                    @(Model.TestType.IsActive ? "Active" : "Inactive")
                                </span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-page="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-trash me-1"></i>Confirm Delete
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>