@page
@model DiagnosticCenter.Web.Pages.TestEntry.IndexModel
@{
    ViewData["Title"] = "Test Entries";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-5">Test Entries</h1>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row mb-3">
        <div class="col">
            <a asp-page="Create" class="btn btn-primary">
                <i class="fas fa-plus me-1"></i>Create New Test Entry
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Bill No</th>
                            <th>Patient Name</th>
                            <th>DOB</th>
                            <th>Mobile No</th>
                            <th>Test Name</th>
                            <th>Total Amount</th>
                            <th>Paid Amount</th>
                            <th>Due Amount</th>
                            <th>Due Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.TestEntries.Any())
                        {
                            @foreach (var item in Model.TestEntries)
                            {
                                <tr>
                                    <td>@item.BillNo</td>
                                    <td>@item.Name</td>
                                    <td>@item.DOB.ToString("MM/dd/yyyy")</td>
                                    <td>@item.MobileNo</td>
                                    <td>@item.TestName</td>
                                    <td>@item.TotalAmount.ToString("C")</td>
                                    <td>@item.PaidAmount.ToString("C")</td>
                                    <td>
                                        <span class="badge @(item.DueAmount > 0 ? "bg-warning text-dark" : "bg-success")">
                                            @item.DueAmount.ToString("C")
                                        </span>
                                    </td>
                                    <td>@item.DueDate.ToString("MM/dd/yyyy")</td>
                                    <td>
                                        <span class="badge @(item.IsActive ? "bg-success" : "bg-danger")">
                                            @(item.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td>
                                        <a asp-page="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm" title="Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-page="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="11" class="text-center">No test entries found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
