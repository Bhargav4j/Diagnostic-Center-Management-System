@page "{id:int}"
@model DiagnosticCenter.Web.Pages.TestEntry.DeleteModel
@{
    ViewData["Title"] = "Delete Test Entry";
}

<div class="container mt-4">
    <h2>Delete Test Entry</h2>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    @if (Model.TestEntry != null)
    {
        <div class="alert alert-warning">
            <h4>Are you sure you want to delete this test entry?</h4>
            <p>This action cannot be undone. All associated payment records will also be affected.</p>
        </div>

        <div class="card">
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Bill Number</dt>
                    <dd class="col-sm-9">@Model.TestEntry.BillNo</dd>

                    <dt class="col-sm-3">Patient Name</dt>
                    <dd class="col-sm-9">@Model.TestEntry.PatientName</dd>

                    <dt class="col-sm-3">Test</dt>
                    <dd class="col-sm-9">@Model.TestEntry.TestSetupName</dd>

                    <dt class="col-sm-3">Test Date</dt>
                    <dd class="col-sm-9">@Model.TestEntry.TestDate.ToString("d")</dd>

                    <dt class="col-sm-3">Total Fee</dt>
                    <dd class="col-sm-9">@Model.TestEntry.TotalFee.ToString("C")</dd>

                    <dt class="col-sm-3">Payment Status</dt>
                    <dd class="col-sm-9">
                        @if (Model.TestEntry.IsPaid)
                        {
                            <span class="badge bg-success">Paid</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Unpaid</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        <form method="post" class="mt-3">
            <button type="submit" class="btn btn-danger">Confirm Delete</button>
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
        </form>
    }
</div>
