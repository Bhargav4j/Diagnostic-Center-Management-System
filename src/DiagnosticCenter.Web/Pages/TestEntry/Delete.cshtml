@page
@model DiagnosticCenter.Web.Pages.TestEntry.DeleteModel
@{
    ViewData["Title"] = "Delete Test Entry";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-10 offset-md-1">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0"><i class="bi bi-trash"></i> Delete Test Entry</h4>
                </div>
                <div class="card-body">
                    @if (Model.TestEntry != null)
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle"></i>
                            <strong>Warning!</strong> Are you sure you want to delete this test entry? This action cannot be undone.
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <dl class="row">
                                    <dt class="col-sm-4">Bill Number</dt>
                                    <dd class="col-sm-8"><span class="badge bg-primary">@Model.TestEntry.BillNo</span></dd>

                                    <dt class="col-sm-4">Patient Name</dt>
                                    <dd class="col-sm-8">@Model.TestEntry.PatientName</dd>

                                    <dt class="col-sm-4">Mobile</dt>
                                    <dd class="col-sm-8">@Model.TestEntry.MobileNo</dd>

                                    <dt class="col-sm-4">DOB</dt>
                                    <dd class="col-sm-8">@Model.TestEntry.DateOfBirth.ToString("dd/MM/yyyy")</dd>
                                </dl>
                            </div>
                            <div class="col-md-6">
                                <dl class="row">
                                    <dt class="col-sm-4">Test</dt>
                                    <dd class="col-sm-8">@(Model.TestEntry.TestName ?? "N/A")</dd>

                                    <dt class="col-sm-4">Total Amount</dt>
                                    <dd class="col-sm-8">@Model.TestEntry.TotalAmount.ToString("C")</dd>

                                    <dt class="col-sm-4">Paid Amount</dt>
                                    <dd class="col-sm-8">@Model.TestEntry.PaidAmount.ToString("C")</dd>

                                    <dt class="col-sm-4">Due Amount</dt>
                                    <dd class="col-sm-8">
                                        @if (Model.TestEntry.DueAmount > 0)
                                        {
                                            <span class="text-danger fw-bold">@Model.TestEntry.DueAmount.ToString("C")</span>
                                        }
                                        else
                                        {
                                            <span class="text-success fw-bold">Paid</span>
                                        }
                                    </dd>
                                </dl>
                            </div>
                        </div>

                        <form method="post">
                            <input type="hidden" asp-for="TestEntry!.Id" />
                            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                <a asp-page="Index" class="btn btn-secondary">
                                    <i class="bi bi-x-circle"></i> Cancel
                                </a>
                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-trash"></i> Delete Test Entry
                                </button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle"></i> Test entry not found.
                        </div>
                        <a asp-page="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
