@page "{id:int}"
@model DiagnosticCenter.Web.Pages.TestEntry.EditModel
@{
    ViewData["Title"] = "Edit Test Entry";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">Edit Test Entry</h2>
                </div>
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" asp-for="TestEntry.Id" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="TestEntry.Name" class="form-label"></label>
                                    <input asp-for="TestEntry.Name" class="form-control" />
                                    <span asp-validation-for="TestEntry.Name" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="TestEntry.DOB" class="form-label">Date of Birth</label>
                                    <input asp-for="TestEntry.DOB" class="form-control" type="date" />
                                    <span asp-validation-for="TestEntry.DOB" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="TestEntry.MobileNo" class="form-label">Mobile Number</label>
                                    <input asp-for="TestEntry.MobileNo" class="form-control" />
                                    <span asp-validation-for="TestEntry.MobileNo" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Bill Number:</label>
                                    <p class="form-control-plaintext">@Model.TestEntry.BillNo</p>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Test:</label>
                                    <p class="form-control-plaintext">@Model.TestEntry.TestName</p>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="TestEntry.TotalAmount" class="form-label">Total Amount</label>
                                    <input asp-for="TestEntry.TotalAmount" class="form-control" type="number" step="0.01" />
                                    <span asp-validation-for="TestEntry.TotalAmount" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="TestEntry.DueDate" class="form-label">Due Date</label>
                                    <input asp-for="TestEntry.DueDate" class="form-control" type="date" />
                                    <span asp-validation-for="TestEntry.DueDate" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="TestEntry.PaidAmount" class="form-label">Paid Amount</label>
                                    <input asp-for="TestEntry.PaidAmount" class="form-control" type="number" step="0.01" />
                                    <span asp-validation-for="TestEntry.PaidAmount" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3 form-check">
                                    <input asp-for="TestEntry.IsActive" class="form-check-input" />
                                    <label asp-for="TestEntry.IsActive" class="form-check-label">Active</label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Due Amount:</label>
                                    <span class="badge @(Model.TestEntry.DueAmount > 0 ? "bg-warning text-dark" : "bg-success") fs-6">
                                        @Model.TestEntry.DueAmount.ToString("C")
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Created Date:</label>
                                <p class="form-control-plaintext">@Model.TestEntry.CreatedDate.ToString("g")</p>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-page="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i>Back to List
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-1"></i>Update Test Entry
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
