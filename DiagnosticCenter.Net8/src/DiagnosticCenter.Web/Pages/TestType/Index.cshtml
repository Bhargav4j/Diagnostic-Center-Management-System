@page
@model DiagnosticCenter.Web.Pages.TestType.IndexModel
@{
    ViewData["Title"] = "Test Types";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Test Types</h2>
        <a asp-page="Create" class="btn btn-primary">Create New</a>
    </div>

    <form method="get" class="mb-3">
        <div class="input-group">
            <input type="text" name="searchTerm" class="form-control" placeholder="Search test types..." value="@Model.SearchTerm" />
            <button type="submit" class="btn btn-outline-secondary">Search</button>
        </div>
    </form>

    @if (!Model.TestTypes.Any())
    {
        <div class="alert alert-info">No test types found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Created Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var testType in Model.TestTypes)
                    {
                        <tr>
                            <td>@testType.Name</td>
                            <td>@testType.CreatedDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                @if (testType.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td>
                                <a asp-page="Details" asp-route-id="@testType.Id" class="btn btn-sm btn-info">Details</a>
                                <a asp-page="Edit" asp-route-id="@testType.Id" class="btn btn-sm btn-warning">Edit</a>
                                <a asp-page="Delete" asp-route-id="@testType.Id" class="btn btn-sm btn-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
