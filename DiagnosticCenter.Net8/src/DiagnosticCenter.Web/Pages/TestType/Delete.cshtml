@page "{id:int}"
@model DiagnosticCenter.Web.Pages.TestType.DeleteModel
@{
    ViewData["Title"] = "Delete Test Type";
}

<div class="container">
    <h1>@ViewData["Title"]</h1>

    <div class="alert alert-danger">
        <p>Are you sure you want to delete this Test Type?</p>
    </div>

    <div class="card">
        <div class="card-body">
            <h5 class="card-title">@Model.TestType.Name</h5>
            <p class="card-text">
                <strong>Description:</strong> @Model.TestType.Description
            </p>
        </div>
    </div>

    <form method="post" class="mt-3">
        <input type="hidden" asp-for="TestType.Id" />
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>