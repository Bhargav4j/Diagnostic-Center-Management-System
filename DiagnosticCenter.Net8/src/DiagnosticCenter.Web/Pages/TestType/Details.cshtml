@page "{id:int}"
@model DiagnosticCenter.Web.Pages.TestType.DetailsModel
@{
    ViewData["Title"] = "Test Type Details";
}

<div class="container">
    <h1>@ViewData["Title"]</h1>

    <div class="card">
        <div class="card-body">
            <h5 class="card-title">@Model.TestType.Name</h5>
            <p class="card-text">
                <strong>Description:</strong> @Model.TestType.Description
            </p>
            <div class="mt-3">
                <a asp-page="Edit" asp-route-id="@Model.TestType.Id" class="btn btn-warning">Edit</a>
                <a asp-page="Delete" asp-route-id="@Model.TestType.Id" class="btn btn-danger">Delete</a>
                <a asp-page="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </div>
</div>