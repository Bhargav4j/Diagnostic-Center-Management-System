@page
@model DiagnosticCenter.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4">Welcome to Diagnostic Center</h1>
    <p class="lead">Professional diagnostic services management system</p>
</div>

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="row mt-5">
        @if (User.IsInRole("Admin"))
        {
            <div class="col-md-6 mb-3">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Test Setup</h5>
                        <p class="card-text">Manage diagnostic tests and their configurations</p>
                        <a asp-page="/TestSetup/Index" class="btn btn-primary">Manage Tests</a>
                    </div>
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Test Types</h5>
                        <p class="card-text">Manage test categories and types</p>
                        <a asp-page="/TestType/Index" class="btn btn-primary">Manage Types</a>
                    </div>
                </div>
            </div>
        }
        @if (User.IsInRole("Receptionist"))
        {
            <div class="col-md-6 mb-3">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Test Entries</h5>
                        <p class="card-text">Manage patient test requests</p>
                        <a asp-page="/TestEntry/Index" class="btn btn-primary">View Entries</a>
                    </div>
                </div>
            </div>
        }
        @if (User.IsInRole("Accountant"))
        {
            <div class="col-md-6 mb-3">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Payments</h5>
                        <p class="card-text">Manage payment transactions</p>
                        <a asp-page="/Payment/Index" class="btn btn-primary">View Payments</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="row mt-5">
        <div class="col-md-12 text-center">
            <p>Please <a asp-page="/Account/Login">login</a> to access the system</p>
        </div>
    </div>
}
