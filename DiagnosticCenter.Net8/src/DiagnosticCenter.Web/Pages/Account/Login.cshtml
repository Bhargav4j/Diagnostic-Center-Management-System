@page
@model DiagnosticCenter.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="login-container">
    <h2>@ViewData["Title"]</h2>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="LoginViewModel.Email">Email</label>
            <input asp-for="LoginViewModel.Email" class="form-control" />
            <span asp-validation-for="LoginViewModel.Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="LoginViewModel.Password">Password</label>
            <input asp-for="LoginViewModel.Password" type="password" class="form-control" />
            <span asp-validation-for="LoginViewModel.Password" class="text-danger"></span>
        </div>

        <div class="form-group">
            <div class="checkbox">
                <label asp-for="LoginViewModel.RememberMe">
                    <input asp-for="LoginViewModel.RememberMe" />
                    @Html.DisplayNameFor(m => m.LoginViewModel.RememberMe)
                </label>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Login</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}