@page "{id:int}"
@model DiagnosticCenter.Web.Pages.TestSetup.DeleteModel
@{
    ViewData["Title"] = "Delete Test Setup";
}

<div class="container">
    <h1>Delete Test Setup</h1>

    <div class="alert alert-danger">
        <p>Are you sure you want to delete this test setup?</p>
    </div>

    <div class="card">
        <div class="card-body">
            <h5 class="card-title">@Model.TestSetup.Name</h5>
            <div class="row">
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Test Type:</dt>
                        <dd class="col-sm-8">@Model.TestSetup.TypeName</dd>

                        <dt class="col-sm-4">Description:</dt>
                        <dd class="col-sm-8">@Model.TestSetup.Description</dd>
                    </dl>
                </div>
            </div>

            <form method="post">
                <input type="hidden" asp-for="TestSetup.Id" />
                <div class="form-group">
                    <input type="submit" value="Delete" class="btn btn-danger" />
                    <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>