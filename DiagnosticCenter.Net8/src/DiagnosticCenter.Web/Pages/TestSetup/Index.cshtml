@page
@model DiagnosticCenter.Web.Pages.TestSetup.IndexModel
@{
    ViewData["Title"] = "Test Setup";
}

<h1>Test Setup Management</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Create New</a>
</p>

<form method="get">
    <div class="row mb-3">
        <div class="col-md-6">
            <div class="input-group">
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search tests..." />
                <button type="submit" class="btn btn-secondary">Search</button>
            </div>
        </div>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Fee</th>
            <th>Type</th>
            <th>Created Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.TestSetups)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Fee.ToString("C")</td>
                <td>@item.TypeName</td>
                <td>@item.CreatedDate.ToShortDateString()</td>
                <td>
                    <a asp-page="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info btn-space">Details</a>
                    <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning btn-space">Edit</a>
                    <a asp-page="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.TestSetups.Any())
{
    <p class="text-center text-muted">No test setups found.</p>
}
