@page
@model DiagnosticCenter.Web.Pages.TestSetup.CreateModel
@{
    ViewData["Title"] = "Create Test Setup";
}

<div class="container">
    <h1>Create Test Setup</h1>

    <form method="post">
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="TestSetup.Name" class="control-label">Test Setup Name</label>
                    <input asp-for="TestSetup.Name" class="form-control" />
                    <span asp-validation-for="TestSetup.Name" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="TestSetup.TypeId" class="control-label">Test Type</label>
                    <select asp-for="TestSetup.TypeId" asp-items="Model.TestTypes" class="form-control">
                        <option value="">-- Select Test Type --</option>
                    </select>
                    <span asp-validation-for="TestSetup.TypeId" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="TestSetup.Description" class="control-label">Description</label>
                    <textarea asp-for="TestSetup.Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="TestSetup.Description" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <input type="submit" value="Create" class="btn btn-primary" />
                    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}