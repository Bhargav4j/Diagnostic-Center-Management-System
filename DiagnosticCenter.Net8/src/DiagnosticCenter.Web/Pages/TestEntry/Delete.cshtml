@page "{id:int}"
@model DiagnosticCenter.Web.Pages.TestEntry.DeleteModel
@{
    ViewData["Title"] = "Delete Test Entry";
}

<div class="container">
    <h1>Delete Test Entry</h1>
    <div class="alert alert-danger">
        <p>Are you sure you want to delete this test entry?</p>
    </div>

    <div class="row">
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Patient Name</dt>
                <dd class="col-sm-8">@Model.TestEntry.Name</dd>

                <dt class="col-sm-4">Date of Birth</dt>
                <dd class="col-sm-8">@Model.TestEntry.DateOfBirth.ToString("dd-MM-yyyy")</dd>

                <dt class="col-sm-4">Test Type</dt>
                <dd class="col-sm-8">@Model.TestEntry.TestName</dd>

                <dt class="col-sm-4">Total Amount</dt>
                <dd class="col-sm-8">@Model.TestEntry.TotalAmount.ToString("C")</dd>

                <dt class="col-sm-4">Due Date</dt>
                <dd class="col-sm-8">@Model.TestEntry.DueDate.ToString("dd-MM-yyyy")</dd>
            </dl>

            <form method="post">
                <input type="hidden" asp-for="TestEntry.Id" />
                <button type="submit" class="btn btn-danger">Confirm Delete</button>
                <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>